{
  "name": "frontend-core-web-vitals-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A lab that demonstrates Core Web Vitals (LCP, INP, CLS) by shipping the same product page twice: an intentionally poor /bad version and an /optimized one.",
  "keywords": ["core-web-vitals", "lcp", "inp", "cls", "react", "typescript", "vite", "lighthouse", "performance"],
  "license": "MIT",
  "author": "Davi Araki",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp"]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "assets": "tsx scripts/generate-assets.ts",
    "postinstall": "tsx scripts/generate-assets.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jiti": "^2.4.2",
    "sharp": "^0.33.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.0"
  }
}
